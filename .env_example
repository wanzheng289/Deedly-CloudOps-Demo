# Copy this file to `.env`, then fill in the values you need.
# Minimal LLM setup: OPENAI_API_KEY + OPENAI_BASE_URL + CHAT_MODEL.
# Recommended provider for this project: AIHubMix / 推理时代.

# -----------------------------------------------------------------------------
# 1. LLM / Agent models
# -----------------------------------------------------------------------------
# Recommended generic names used by the project.
# AIHubMix key: create it on 推理时代, then paste it here.
OPENAI_API_KEY=sk-your-aihubmix-api-key
OPENAI_BASE_URL=https://aihubmix.com/v1

# Default recommendation for this Agent/RAG project:
# DeepSeek-V3.2-Think: strong reasoning + agent/tool/function-calling support.
# Model page: https://aihubmix.com/model/deepseek-v3.2-think
CHAT_MODEL=deepseek-v3.2-think

# Domestic model alternatives on AIHubMix / 推理时代:
# 1. deepseek-v3.2-think
#    Best default for agentic reasoning, tool calling, structured outputs.
#    URL: https://aihubmix.com/model/deepseek-v3.2-think
# 2. qwen3.5-plus
#    Good general-purpose Chinese/English dialogue and RAG fallback.
#    URL: https://aihubmix.com/model/qwen3.5-plus
# 3. glm-5
#    Good domestic general model option, useful as alternate grader/router.
#    URL: https://aihubmix.com/model/glm-5
# 4. coding-glm-5.1
#    Coding-oriented option for code review/refactor tasks.
#    URL: https://aihubmix.com/model/coding-glm-5.1

# Optional: model used by RAG relevance grading / query routing.
# Keep it cheaper/faster than CHAT_MODEL if you want to control cost.
# Recommended domestic choices: qwen3.5-plus or glm-5.
GRADE_MODEL=qwen3.5-plus

# LangChain model provider. Keep `openai` for OpenAI-compatible APIs.
MODEL_PROVIDER=openai

# Backward-compatible aliases kept for older code/scripts.
# You may leave these empty if OPENAI_* and CHAT_MODEL are set.
ARK_API_KEY=
BASE_URL=
MODEL=

# -----------------------------------------------------------------------------
# 2. Embedding / Retrieval
# -----------------------------------------------------------------------------
# Local embedding model. No API key is required, but the first run may download
# the model from Hugging Face unless already cached.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024
BM25_STATE_PATH=./data/runtime/bm25_state.json

# RAG behavior.
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3

# Optional rerank service. Recommended for better RAG recall precision.
# AIHubMix rerank endpoint: https://aihubmix.com/v1/rerank
# Default recommendation: qwen3-reranker-4b for better Chinese/English RAG quality.
# Model page: https://aihubmix.com/model/qwen3-reranker-4b
RERANK_API_KEY=sk-your-aihubmix-api-key
RERANK_MODEL=qwen3-reranker-4b
RERANK_BINDING_HOST=https://aihubmix.com

# Low-latency / lower-cost alternative:
# RERANK_MODEL=qwen3-reranker-0.6b
# URL: https://aihubmix.com/model/qwen3-reranker-0.6b

# Other available AIHubMix rerank option:
# RERANK_MODEL=jina-reranker-m0
# Endpoint docs: https://docs.aihubmix.com/en/api/Jina-AI

# Alternative alias if your rerank service uses a base URL name.
RERANK_BASE_URL=

# -----------------------------------------------------------------------------
# 3. Databases / Vector DB / Graph DB
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_customer_ops

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=enterprise_customer_ops
REDIS_CACHE_TTL_SECONDS=300

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=enterprise_customer_ops_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# -----------------------------------------------------------------------------
# 4. Backend server / Auth
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_INVITE_CODE=
PASSWORD_PBKDF2_ROUNDS=310000

# -----------------------------------------------------------------------------
# 5. Optional tools
# -----------------------------------------------------------------------------
# Weather tool. Leave empty if you do not need it.
AMAP_API_KEY=
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
